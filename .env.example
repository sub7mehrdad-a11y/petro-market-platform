# این فایل رو کپی کن به .env و مقدار واقعی رو داخلش بذار — .env هرگز کامیت نمی‌شه.
# برای اجرای محلی اسکریپت‌های scripts/*.py:
ANTHROPIC_API_KEY=sk-ant-...

# همین متغیر رو در گیت‌هاب هم اینجا ثبت کن، نه داخل کد:
# Settings > Secrets and variables > Actions > New repository secret > ANTHROPIC_API_KEY
