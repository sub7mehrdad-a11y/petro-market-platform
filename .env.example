# این فایل رو کپی کن به .env و مقدار واقعی رو داخلش بذار — .env هرگز کامیت نمی‌شه.

# ---------------------------------------------------------------- Gemini
# کلید رایگان (بدون کارت اعتباری) از aistudio.google.com > Get API Key بگیر.

# ایجنت‌های روزانه‌ی scripts/*.py (قیمت، اخبار، رصد ترکیه و چین)
GEMINI_API_KEY=...

# فقط برای «پاسخ هوشمند» /ask — عمداً جدا، تا سؤال‌های کاربران سهمیه‌ی روزانه‌ی
# ایجنت‌های خودکار را نخوابانَد. اگر تعریف نشود، از کلید بالا استفاده می‌شود.
GEMINI_API_KEY_ASK=...

# ------------------------------------------------------------------ Groq
# کلید رایگان از console.groq.com. سقف سرویس رایگان: ۸۰۰۰ توکن در دقیقه.

# ربات ترانزیت (scripts/transit_watch_bot.py) — پردازش سنگین روزانه‌ی پست‌های کانال
GROQ_API_KEY=...

# فقط برای «پاسخ هوشمند» /ask — به همان دلیل بالا جداست. اگر تعریف نشود، از
# کلید بالا استفاده می‌شود.
GROQ_API_KEY_ASK=...

# کلید اختصاصی scripts/exhibitor_lead_finder.py (--engine groq) — تا طبقه‌بندی
# سنگین لیست نمایشگاه‌ها سهمیه‌ی مشترک بالا را نخورد.
GROQ_API_KEY_EXHIBITOR=...

# --------------------------------------------------------------- تلگرام
# ربات گزارش هفتگی مدیران (scripts/weekly_report_bot.py). توکن رو از @BotFather
# بگیر. برای TELEGRAM_CHAT_IDS، اول هر مدیر باید یک‌بار به ربات /start بزنه،
# بعد scripts/telegram_setup.py رو اجرا کن تا شناسه‌ها رو چاپ کنه.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_IDS=...,...

# ----------------------------------------------------------------- شبکه
# فقط برای اجرای محلی در ایران: Groq و Gemini مستقیم در دسترس نیستند.
# آدرس پراکسی/VPN محلی خودت را بگذار. بدون این خط، سایتی که با «اجرای-سایت.bat»
# بالا می‌آید خطای ۴۰۳ می‌دهد — حتی اگر پراکسی روی سیستم روشن باشد، چون متغیر
# محیطی ویندوز آن را نمی‌بیند. روی گیت‌هاب اکشنز اصلاً لازم نیست.
HTTPS_PROXY=http://127.0.0.1:10808

# ------------------------------------------------------------ گیت‌هاب اکشنز
# همین کلیدها را در مخزن هم ثبت کن، نه داخل کد:
# Settings > Secrets and variables > Actions > New repository secret
#   GEMINI_API_KEY  و  GROQ_API_KEY  و  TELEGRAM_BOT_TOKEN  و  TELEGRAM_CHAT_IDS
